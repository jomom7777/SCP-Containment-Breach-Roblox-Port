local normalTex =  game.Workspace["SCP-173"]:FindFirstChild("NormalTex")
local halloTex = game.Workspace["SCP-173"]:FindFirstChild("HalloweenTex")
local date = os.date("*t")

-- SCP-173

local module = {}
function module.scp173_texture()
	if date.month == 10 and date.day == 31 then
		halloTex.Transparency = 0
		normalTex.Transparency = 1
	elseif not (date.month == 10 and date.day == 31) then
		normalTex.Transparency = 0
		halloTex.Transparency = 1
	end
end

-- SCP-066

function module.scp066_beethoven()
	game.Workspace:FindFirstChild("SCP-066").music:Play()
end

